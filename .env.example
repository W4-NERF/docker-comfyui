# ──────────────────────────────────────────
# ComfyUI Docker Stack - Example Config
# ──────────────────────────────────────────
# Copy this to .env and adjust values:
#   cp .env.example .env

COMFYUI_VERSION=v0.24.1
COMFYUI_PORT=8188
COMFYUI_EXTRA_ARGS=--lowvram

# Host interface to bind to. 127.0.0.1 = local only (recommended).
# Set 0.0.0.0 to expose on your network (then put a reverse proxy + auth in front).
BIND_ADDR=127.0.0.1

COMFYUI_UID=1000
COMFYUI_GID=1000

MODELS_PATH=./data/models
OUTPUT_PATH=./data/output
CUSTOM_NODES_PATH=./data/custom_nodes
USER_DATA_PATH=./data/user_data

NVIDIA_VISIBLE_DEVICES=all

# ── torch / CUDA build ──────────────────────────────────────
# Pick a tag that exists at https://download.pytorch.org/whl/<tag>.
# ComfyUI v0.24.1+ wants torch >= 2.8, so cu124 (capped at torch 2.6) is
# NOT recommended anymore — it triggers "Unsupported Pytorch" warnings
# and disables DynamicVRAM / optimized CUDA ops.
#
# cu126 → torch 2.6 – 2.9, oldest drivers that still get current torch (~R555+)
# cu128 → torch 2.7 – 2.9, broad compatibility (~R570+). Default.
# cu130 → torch 2.9+, newest GPUs only, needs very recent driver (~R580+)
CUDA_VARIANT=cu128

# ── Pinning knobs (optional) ────────────────────────────────
# Leave these unset for the current, unpinned behavior: torch, the
# openai-agents package, and ComfyUI-Manager all resolve to the latest
# compatible/default-branch version at build/first-run time. Pin them if a
# future rebuild or Manager update breaks something and you want to freeze a
# known-good combination. Changing TORCH_PACKAGES / OPENAI_AGENTS_PACKAGE
# requires a rebuild (`docker compose build`); COMFYUI_MANAGER_REF only
# affects a fresh Manager install (see docker-entrypoint.sh).
#TORCH_PACKAGES=torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0
#OPENAI_AGENTS_PACKAGE=openai-agents==0.x.y
#COMFYUI_MANAGER_REF=

DOCKER_NETWORK=comfyui-net
