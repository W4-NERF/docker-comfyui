# ──────────────────────────────────────────
# ComfyUI Docker Stack - Example Config
# ──────────────────────────────────────────
# Copy this to .env and adjust values:
#   cp .env.example .env

COMFYUI_VERSION=v0.24.1
COMFYUI_PORT=8188
COMFYUI_EXTRA_ARGS=--highvram
COMFYUI_UID=1000
COMFYUI_GID=1000

MODELS_PATH=./data/models
OUTPUT_PATH=./data/output
CUSTOM_NODES_PATH=./data/custom_nodes
USER_DATA_PATH=./data/user_data

NVIDIA_VISIBLE_DEVICES=all

DOCKER_NETWORK=comfyui-net
